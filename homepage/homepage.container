[Unit]
Description=Homepage Dashboard

[Container]
AutoUpdate=registry
ContainerName=homepage
Environment=TZ=Europe/Berlin
Environment=HOMEPAGE_ALLOWED_HOSTS=10.0.10.2:3002,homepage.chrayed.de
Environment=PUID=1001
Environment=PGID=1001
Image=ghcr.io/gethomepage/homepage:latest
Pod=homepage.pod
Volume=/run/user/1001/podman/podman.sock:/var/run/podman.sock
Volume=homepage-config:/app/config

[Service]
Restart=always

[Install]
WantedBy=default.target
