[Unit]
Description=FreshRSS
After=rss-database.service
Requires=rss-database.service

[Container]
AutoUpdate=registry
ContainerName=freshrss
Environment=TZ=Europe/Berlin
Environment=CRON_MIN=1,31
Environment=LISTEN=0.0.0.0:8080
Image=docker.io/freshrss/freshrss:latest
Pod=rss.pod
Volume=freshrss-data.volume:/var/www/FreshRSS/data
Volume=freshrss-extensions.volume:/var/www/FreshRSS/extensions

[Service]
Restart=always

[Install]
WantedBy=default.target
